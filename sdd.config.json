{
  "$schema": "https://raw.githubusercontent.com/tBeltty/agentic-sdd-framework/v1.6.0/scripts/lib/sdd.config.schema.json",
  "version": "1.6.0",
  "project": {
    "name": "agentic-sdd-framework",
    "type": "framework",
    "runtime": "node-24-lts"
  },
  "specification": {
    "mode": "lite",
    "allowedModes": [
      "lite",
      "rigor"
    ]
  },
  "discovery": {
    "concurrency": "N/A -- CLI tool, no request traffic",
    "hardware": "developer machines and GitHub Actions runners (ubuntu/macos/windows)",
    "workload": "filesystem/git scripts, spawns short-lived child processes (npm test, sdd-verify, quality gate checks)"
  },
  "architecture": {
    "style": "clean-architecture",
    "maxLocPerFile": 400
  },
  "capabilities": {
    "noAiSlop": {
      "enabled": true
    },
    "astNavigation": {
      "adapter": "ast-grep"
    },
    "i18n": {
      "enabled": false
    },
    "pwa": {
      "enabled": false
    },
    "guardrails": {
      "enabled": true
    }
  }
}
