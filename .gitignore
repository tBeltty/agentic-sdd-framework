# -----------------------------------------------------------------------------
# 🛡️ Zero-Trust Security & Secrets Isolation
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.vault
*.vault
secrets/
*.pem
*.key
*.cert
*.p12

# -----------------------------------------------------------------------------
# 🧹 Quarantine & Scratch Workspace
# -----------------------------------------------------------------------------
scratch/
*/scratch/
.scratch/
tmp/
temp/

# -----------------------------------------------------------------------------
# 📦 Dependency & Build Artifacts
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# 🐍 Python / Runtime Caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/

# -----------------------------------------------------------------------------
# 🕸️ AST & Indexer Caches
# -----------------------------------------------------------------------------
graphify-out/cache/
.ast-grep/
.cache/

# -----------------------------------------------------------------------------
# 💻 Operating System & Editor Metadata
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/
*.swp
*.swo

# The Auditor-Executor protocol is an external dependency (auditkit). Running sdd-init in
# this checkout installs its skill locally; it must never be committed here.
.agents/skills/auditor-executor-protocol/
.claude/skills/auditor-executor-protocol
.sdd/session-log.jsonl
.sdd/current-task
