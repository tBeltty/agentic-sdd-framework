{
  "name": "agentic-sdd-framework",
  "version": "1.1.0",
  "description": "The Universal Open-Source Operating System for Spec-Driven Development with AI Agents",
  "main": "scripts/sdd-init.js",
  "bin": {
    "sdd-init": "scripts/sdd-init.js"
  },
  "files": [
    "scripts/",
    ".agents/",
    "docs/",
    "sdd.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "init": "node scripts/sdd-init.js",
    "check:prereqs": "node scripts/check-system-prerequisites.js",
    "check:secrets": "node scripts/verify-no-secrets.js",
    "check:slop": "node scripts/check-copy-slop.js",
    "check:size": "node scripts/check-file-size.js",
    "check:versions": "node scripts/check-versions.js",
    "install-hooks": "node scripts/install-git-hooks.js",
    "quality-gate": "node scripts/quality-gate.js"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "ai-agents",
    "claude-code",
    "antigravity",
    "cursor",
    "governance",
    "auditor-executor"
  ],
  "author": "tBeltty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tBeltty/agentic-sdd-framework.git"
  }
}
